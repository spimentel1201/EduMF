# Variables de entorno del backend
# Copiar a .env y completar los valores reales. Nunca commitear .env.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/school-attendance
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web Push (VAPID) para la PWA SIGES
# Generar con: node -e "..." o `npx web-push generate-vapid-keys` (Fase 3).
# El subject debe ser un mailto: o una URL https de la institución.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tucolegio.edu.pe
